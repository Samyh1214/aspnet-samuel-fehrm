<section class="section__contact">
    <div class="container">

        <div class="contact-area">
            <div class="contact-image">
                <img src="~/images/contact-us-image.png" alt="Contact us" />
                <div class="contact-image__overlay">
                    <div class="contact-image__overlay-item">
                        <div class="contact-image__overlay-icon contact-image__overlay-icon--phone"></div>
                        <div>
                            <p class="contact-image__overlay-label">Phone Number</p>
                            <p class="contact-image__overlay-value">+(46) 8 410 521 00</p>
                        </div>
                    </div>
                    <div class="contact-image__overlay-item">
                        <div class="contact-image__overlay-icon contact-image__overlay-icon--email"></div>
                        <div>
                            <p class="contact-image__overlay-label">Email Address</p>
                            <p class="contact-image__overlay-value">info@corefitness.se</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form">
                <h3>Contact Us Today</h3>
                <p>Ready to begin your fitness journey? Contact GymPro today and let our expert trainers guide you with the right program and support.</p>
                <form class="contact-form__fields">
                    <div class="contact-form__row">
                        <div class="form-group" data-type="firstname">
                            <label class="form-label">First Name *</label>
                            <input class="form-input" type="text" placeholder="Enter First Name" />
                        </div>
                        <div class="form-group" data-type="lastname">
                            <label class="form-label">Last Name *</label>
                            <input class="form-input" type="text" placeholder="Enter Last Name" />
                        </div>
                    </div>
                    <div class="contact-form__row">
                        <div class="form-group" data-type="email">
                            <label class="form-label">Email Address *</label>
                            <input class="form-input" type="email" placeholder="Enter Email Address" />
                        </div>
                        <div class="form-group" data-type="phone">
                            <label class="form-label">Phone Number</label>
                            <input class="form-input" type="tel" placeholder="Enter Phone Number" />
                        </div>
                    </div>
                    <div class="form-group" data-type="message">
                        <label class="form-label">Message *</label>
                        <textarea class="form-input" placeholder="Message..."></textarea>
                    </div>
                    <button type="submit" class="btn" data-type="submit">Submit Message</button>
                </form>
            </div>
        </div>
    </div>
</section>